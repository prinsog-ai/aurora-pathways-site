# Valence Carbon Credit — Deploy Config
# Copy to .env and fill in real values

# Deployer private key (no 0x prefix)
PRIVATE_KEY=

# Owner address (multisig recommended for production)
OWNER_ADDRESS=

# Chain: polygon, amoy, anvil
CHAIN=polygon

# RPC URLs
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=

# Etherscan/Polygonscan API key for verification
POLYGONSCAN_API_KEY=
