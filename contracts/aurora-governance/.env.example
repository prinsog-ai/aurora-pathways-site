# Aurora Governance — Environment Variables
# Copy this to .env and fill in your values

# ─── Deployer ───
PRIVATE_KEY=0x_your_private_key_here

# ─── Initial Token Owner ───
OWNER_ADDRESS=0x_your_owner_address_here

# ─── Treasury Multisig Signers (3 required) ───
SIGNER_1=0x_signer_1_address
SIGNER_2=0x_signer_2_address
SIGNER_3=0x_signer_3_address

# ─── RPC URLs (optional, for multi-chain deploy) ───
# Polygon PoS (chain 137)
POLYGON_RPC_URL=https://polygon-rpc.com
# Polygon Amoy (testnet, chain 80002)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Base (chain 8453)
BASE_RPC_URL=https://mainnet.base.org
# Base Sepolia (testnet, chain 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Arbitrum (chain 42161)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ─── Explorer API Keys (for contract verification) ───
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
