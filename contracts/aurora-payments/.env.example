# ============================================================
# Aurora Pathways — Multi-Chain Deploy Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# === Deployer Wallet ===
PRIVATE_KEY=          # Private key (no 0x prefix)
OWNER_ADDRESS=        # Initial contract owner address

# === Chain Selection ===
# Options: polygon, amoy, base, base-sepolia, arbitrum, arbitrum-sepolia, anvil
CHAIN=anvil

# === RPC URLs ===
# Get free RPCs from: infura.io, alchemy.com, or use public endpoints
ANVIL_RPC_URL=http://localhost:8545

# Polygon (Mainnet)
POLYGON_RPC_URL=https://polygon-rpc.com
# Polygon Amoy (Testnet) — get MATIC from faucet.polygon.technology
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Base (Mainnet)
BASE_RPC_URL=https://mainnet.base.org
# Base Sepolia (Testnet) — get ETH from faucet: bridge.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Arbitrum (Mainnet)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Arbitrum Sepolia (Testnet)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# === Explorer API Keys (for contract verification) ===
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=

# === Stablecoin Addresses (for AuroraPayments) ===
# Polygon Mainnet
POLYGON_USDC=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
POLYGON_USDT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
POLYGON_DAI=0x8f3Cf7ad23Cd3CaDbD9735AFf958023239c6A063

# Base Mainnet
BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Arbitrum Mainnet
ARBITRUM_USDC=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
ARBITRUM_USDT=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9
ARBITRUM_DAI=0xDA10009cBd5D07dd0CeCc66161FC93D7c9000da1